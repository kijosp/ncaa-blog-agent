# Discovery pipeline environment variables
# Copy this file to .env and fill in your values:
#   cp .env_setup .env

# AWS profile name from ~/.aws/credentials
AWS_PROFILE=your-aws-profile

# AWS region where AgentCore is deployed
AWS_DEFAULT_REGION=us-east-1

# Gateway MCP endpoint URL (from SSM: /<stack-name>/gateway_url)
GATEWAY_URL=https://your-gateway-id.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp

# Cognito M2M credentials for Gateway authentication
# These are the machine client credentials created by the CDK stack.
# Find them via: aws ssm get-parameter --name "/<stack-name>/machine_client_id"
# and: aws cognito-idp describe-user-pool-client --user-pool-id <pool-id> --client-id <client-id>
COGNITO_DOMAIN=your-stack-name-123456789012-us-east-1.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-machine-client-id
COGNITO_CLIENT_SECRET=your-cognito-machine-client-secret

# Optional: override the default Bedrock model
# MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# DynamoDB table for blog registry
REGISTRY_TABLE=blog-discovery-registry