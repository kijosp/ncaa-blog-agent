# Blog Search Agent environment variables
# Copy this file to .env and fill in your values:
#   cp .env_setup .env

# AWS profile name from ~/.aws/credentials
AWS_PROFILE=

# AWS region where resources are deployed
AWS_DEFAULT_REGION=us-east-1

# Gateway MCP endpoint URL (for web search tool)
GATEWAY_URL=

# Cognito M2M credentials for Gateway authentication
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# Optional: pre-fetched gateway token (skips Cognito token exchange if set)
# GATEWAY_TOKEN=

# DynamoDB table for blog discovery registry
REGISTRY_TABLE=blog-discovery-registry

# Optional: override the default Bedrock model (default: us.anthropic.claude-sonnet-4-6)
# MODEL_ID=

# Optional: override default lookback days for chat mode (default: 7)
# DEFAULT_LOOKBACK_DAYS=7

# Optional: AgentCore Memory (only needed if running with session memory)
# MEMORY_ID=
